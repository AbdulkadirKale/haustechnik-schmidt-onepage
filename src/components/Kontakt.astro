---
import { getEntry } from 'astro:content';

const firmenprofil = (await getEntry('firmenprofil', 'firmenprofil'))?.data;
const startseite = (await getEntry('startseite', 'startseite'))?.data;
const phone = firmenprofil?.phone ?? '';
const email = firmenprofil?.email ?? '';
const address = firmenprofil ? `${firmenprofil.street}\n${firmenprofil.postalCode} ${firmenprofil.city}` : '';
const phoneHref = phone.replace(/[^\d+]/g, '');
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${firmenprofil?.street ?? ''} ${firmenprofil?.postalCode ?? ''} ${firmenprofil?.city ?? ''}`)}`;
---

<section id="kontakt" class="reveal bg-slate-100 py-24 text-slate-950 opacity-0 translate-y-10 transition-all duration-500 lg:py-32">
	<div class="mx-auto grid max-w-7xl gap-16 px-6 lg:grid-cols-[0.8fr_1.2fr] lg:px-10">
		<div>
			<p class="mb-4 text-sm font-bold uppercase tracking-[0.2em] text-cyan-700">{startseite?.contactLabel}</p>
			<h2 class="max-w-md text-4xl font-semibold tracking-tight sm:text-5xl">{startseite?.contactHeadline}</h2>
			<p class="mt-6 max-w-md whitespace-pre-line leading-7 text-slate-600">{startseite?.contactSubtext}</p>
			<div class="mt-10 space-y-6 border-t border-slate-300 pt-8">
				<div><p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-500">{startseite?.phoneLabel}</p><a href={`tel:${phoneHref}`} class="relative z-10 mt-2 block w-fit text-lg font-semibold transition hover:text-cyan-700">{phone}</a></div>
				<div><p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-500">{startseite?.emailLabel}</p><a href={`mailto:${email}`} class="relative z-50 cursor-pointer block mt-2 w-fit text-lg font-semibold transition hover:text-cyan-700">{email}</a></div>
				<div><p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-500">{startseite?.addressLabel}</p><a href={mapsHref} target="_blank" rel="noopener noreferrer" class="relative z-10 mt-2 block w-fit whitespace-pre-line text-lg font-semibold leading-7 transition hover:text-cyan-700">{address}</a></div>
			</div>
		</div>
		<form action="#" method="post" onsubmit="event.preventDefault(); alert('Nachricht gesendet!');" class="rounded-3xl border border-slate-200 bg-white p-8 shadow-xl shadow-blue-900/10 lg:p-10">
			<div class="grid gap-6 sm:grid-cols-2">
				<label class="block text-sm font-semibold text-slate-700"><span class="mb-2 block">{startseite?.formNameLabel}</span><input type="text" name="name" autocomplete="name" required class="w-full border border-slate-300 bg-slate-50 px-4 py-3.5 text-slate-950 outline-none transition focus:border-cyan-700 focus:ring-2 focus:ring-cyan-700/20" /></label>
				<label class="block text-sm font-semibold text-slate-700"><span class="mb-2 block">{startseite?.formEmailLabel}</span><input type="email" name="email" autocomplete="email" required class="w-full border border-slate-300 bg-slate-50 px-4 py-3.5 text-slate-950 outline-none transition focus:border-cyan-700 focus:ring-2 focus:ring-cyan-700/20" /></label>
			</div>
			<label class="mt-6 block text-sm font-semibold text-slate-700"><span class="mb-2 block">{startseite?.formMessageLabel}</span><textarea name="message" rows="6" required class="w-full resize-y border border-slate-300 bg-slate-50 px-4 py-3.5 text-slate-950 outline-none transition focus:border-cyan-700 focus:ring-2 focus:ring-cyan-700/20"></textarea></label>
			<button type="submit" class="mt-6 inline-flex items-center gap-3 rounded-xl bg-slate-950 px-6 py-3.5 text-sm font-bold text-white transition-all duration-300 hover:-translate-y-2 hover:bg-cyan-800 hover:shadow-2xl hover:shadow-blue-950/30">{startseite?.formSubmitText} <span aria-hidden="true">→</span></button>
		</form>
	</div>
</section>
