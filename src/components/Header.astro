---
import { getEntry } from 'astro:content';

const firmenprofil = (await getEntry('firmenprofil', 'firmenprofil'))?.data;
const startseite = (await getEntry('startseite', 'startseite'))?.data;
const notdienstActive = firmenprofil?.notdienstActive ?? false;
const notdienstNumber = firmenprofil?.notdienstNumber ?? '';
const phone = firmenprofil?.phone ?? '';
const phoneHref = phone.replace(/[^\d+]/g, '');
const notdienstPhoneHref = notdienstNumber.replace(/[^\d+]/g, '');
---

<header id="site-header" class="fixed top-0 w-full z-50">
	<div class="absolute inset-0 backdrop-blur-sm z-0 pointer-events-none" aria-hidden="true"></div>
	<div class="absolute inset-0 bg-slate-900/85 border-b border-slate-800/60 z-0 pointer-events-none" aria-hidden="true"></div>
	{notdienstActive && (
		<aside class="relative z-10 bg-red-700 px-6 py-3 text-sm font-semibold text-red-50" aria-label="Notdienst">
			<div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-4 gap-y-1">
				<span class="inline-flex items-center gap-2 uppercase tracking-[0.14em]"><span class="h-2 w-2 shrink-0 animate-pulse rounded-full bg-red-200"></span> {startseite?.notdienstLabel}</span>
				<a href={`tel:${notdienstPhoneHref}`} class="relative z-10 font-bold transition hover:text-white">{notdienstNumber}</a>
			</div>
		</aside>
	)}
	<nav class="relative z-10 mx-auto max-w-7xl px-6 py-5 lg:px-10" aria-label="Hauptnavigation">
		<div class="flex items-center justify-between gap-6">
			<a href="/" class="relative z-10 text-lg font-semibold tracking-tight text-white">{firmenprofil?.companyName}</a>
			<div class="hidden shrink-0 items-center gap-8 md:flex">
				<a href="/#leistungen" class="relative z-10 text-sm font-medium text-slate-300 transition hover:text-cyan-300">Leistungen</a>
				<a href="/#ueber-uns" class="relative z-10 text-sm font-medium text-slate-300 transition hover:text-cyan-300">Über uns</a>
				<a href="/#kontakt" class="relative z-10 text-sm font-medium text-slate-300 transition hover:text-cyan-300">Kontakt</a>
				<a href={`tel:${phoneHref}`} class="relative z-10 inline-flex shrink-0 items-center gap-2 whitespace-nowrap text-sm font-semibold text-slate-200 transition hover:text-cyan-300">
					<span class="h-2 w-2 shrink-0 rounded-full bg-cyan-300"></span>{phone}
				</a>
			</div>
			<button type="button" id="mobile-menu-toggle" class="relative z-10 inline-flex h-11 w-11 items-center justify-center rounded-xl text-slate-200 transition-colors hover:text-cyan-300 md:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menü öffnen">
				<span class="sr-only">Menü öffnen</span>
				<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
			</button>
		</div>
		<div id="mobile-menu" class="hidden flex-col gap-1 pb-3 pt-4 md:hidden">
			<a href="/#leistungen" class="relative z-10 block px-2 py-3 text-sm font-medium text-slate-300 transition hover:text-cyan-300">Leistungen</a>
			<a href="/#ueber-uns" class="relative z-10 block px-2 py-3 text-sm font-medium text-slate-300 transition hover:text-cyan-300">Über uns</a>
			<a href="/#kontakt" class="relative z-10 block px-2 py-3 text-sm font-medium text-slate-300 transition hover:text-cyan-300">Kontakt</a>
			<a href={`tel:${phoneHref}`} class="relative z-10 block px-2 py-3 text-sm font-semibold text-cyan-300">{phone}</a>
		</div>
	</nav>
</header>

<script is:inline>
	(() => {
		const header = document.getElementById('site-header');
		if (!header) return;
		const sync = () => {
			const menu = document.getElementById('mobile-menu');
			if (menu && !menu.classList.contains('hidden')) return;
			document.documentElement.style.setProperty('--header-h', header.offsetHeight + 'px');
		};
		sync();
		new ResizeObserver(sync).observe(header);
	})();
</script>

<script>
	const menuToggle = document.querySelector('#mobile-menu-toggle');
	const mobileMenu = document.querySelector('#mobile-menu');
	menuToggle?.addEventListener('click', () => {
		const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
		menuToggle.setAttribute('aria-expanded', String(!isOpen));
		mobileMenu?.classList.toggle('hidden', isOpen);
		mobileMenu?.classList.toggle('flex', !isOpen);
	});
	mobileMenu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			menuToggle?.setAttribute('aria-expanded', 'false');
			mobileMenu?.classList.add('hidden');
			mobileMenu?.classList.remove('flex');
		});
	});
</script>
