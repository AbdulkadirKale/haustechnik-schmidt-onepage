---
import Header from '../components/Header.astro';
import Kontakt from '../components/Kontakt.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { title = 'Haustechnik Schmidt', description = 'Haustechnik Schmidt: Sanitär, Heizung und Wartung in Berlin.' } = Astro.props;
---

<html lang="de" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class="bg-slate-50 pt-[var(--header-h,6rem)] text-slate-950 antialiased">
		<Header />
		<slot />
		<Kontakt />
		<Footer />

		<script>
			const revealElements = document.querySelectorAll('.reveal');
			const show = (element: Element) => {
				element.classList.remove('opacity-0', 'translate-y-10');
				element.classList.add('opacity-100', 'translate-y-0');
			};

			if (!('IntersectionObserver' in window)) {
				revealElements.forEach(show);
			} else {
				const revealObserver = new IntersectionObserver((entries, observer) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						show(entry.target);
						observer.unobserve(entry.target);
					});
				}, { threshold: 0.1, rootMargin: '50px' });
				revealElements.forEach((element) => revealObserver.observe(element));
			}
		</script>
	</body>
</html>
